#!/bin/bash

set -u

CONTAINER_NAME="xiaomi-camera-daily-story-app"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib
source "${SCRIPT_DIR}/_lib"

if [ -n "${TRIM_APPDEST:-}" ]; then
  : "${TRIM_PKGETC:=${TRIM_APPDEST}/etc}"
  : "${TRIM_PKGVAR:=${TRIM_APPDEST}/var}"
  : "${TRIM_DATA_SHARE_PATHS:=${TRIM_APPDEST}/shares/videos}"
fi
RECREATE_FLAG="${XIAOMI_WATCHER_RECREATE_FLAG:-/run/xiaomi-camera-daily-story-recreating}"

write_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
  else
    printf '%s\n' "$1" >&2
  fi
}

is_recreating() {
  [ -f "$RECREATE_FLAG" ] || return 1
  [ -n "$(find "$RECREATE_FLAG" -mmin -1 2>/dev/null)" ]
}

is_running() {
  [ -n "${TRIM_APPDEST:-}" ] || return 1
  is_recreating && return 0
  docker inspect --format '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null \
    | grep -qx true
}

stage_recreate_docker_project() {
  [ "${XIAOMI_DISABLE_RECREATE:-0}" = "1" ] && return 0
  local compose="${TRIM_APPDEST}/docker/docker-compose.yaml"
  [ -f "$compose" ] || return 0
  # 首次安装时容器尚不存在，交给应用中心按 Compose 创建。
  docker inspect "$CONTAINER_NAME" >/dev/null 2>&1 || return 0
  docker compose --project-name "xiaomi-camera-daily-story" --file "$compose" \
    up -d --force-recreate \
    || stage_fail "重建 Docker 容器失败，请检查应用日志。"
}

stage_ensure_authorized_mounts_watcher() {
  [ "${XIAOMI_DISABLE_WATCHER:-0}" = "1" ] && return 0
  local watcher="${SCRIPT_DIR}/authorized-mounts-watcher"
  [ -x "$watcher" ] || return 0
  local pid_file="${XIAOMI_WATCHER_PID_FILE:-/run/xiaomi-camera-daily-story-watcher.pid}"
  if [ -f "$pid_file" ]; then
    local pid
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    case "$pid" in
      ''|*[!0-9]*) ;;
      *)
        if ps -p "$pid" -o args= 2>/dev/null | grep -q 'authorized-mounts-watcher'; then
          return 0
        fi
        ;;
    esac
  fi
  rmdir "${XIAOMI_WATCHER_LOCK_DIR:-/run/xiaomi-camera-daily-story-watcher.lock}" 2>/dev/null || true
  if command -v setsid >/dev/null 2>&1; then
    setsid "$watcher" >> "${TRIM_PKGVAR}/authorized-mounts-watcher.log" 2>&1 < /dev/null &
  else
    nohup "$watcher" >> "${TRIM_PKGVAR}/authorized-mounts-watcher.log" 2>&1 < /dev/null &
  fi
}

stage_start_authorized_mounts_watcher() {
  [ "${XIAOMI_DISABLE_WATCHER:-0}" = "1" ] && return 0
  local pid_file="${XIAOMI_WATCHER_PID_FILE:-/run/xiaomi-camera-daily-story-watcher.pid}"
  if [ -f "$pid_file" ]; then
    local old_pid
    old_pid="$(cat "$pid_file" 2>/dev/null || true)"
    case "$old_pid" in
      ''|*[!0-9]*) ;;
      *)
        if ps -p "$old_pid" -o args= 2>/dev/null | grep -q 'authorized-mounts-watcher'; then
          kill "$old_pid" 2>/dev/null || true
          sleep 1
          kill -0 "$old_pid" 2>/dev/null && kill -9 "$old_pid" 2>/dev/null || true
        fi
        ;;
    esac
    rm -f "$pid_file"
  fi
  rmdir "${XIAOMI_WATCHER_LOCK_DIR:-/run/xiaomi-camera-daily-story-watcher.lock}" 2>/dev/null || true
  stage_ensure_authorized_mounts_watcher
}

case "${1:-}" in
  start)
    stage_require_environment
    stage_require_runtime_directories
    stage_render_authorized_video_mounts
    stage_recreate_docker_project
    stage_start_authorized_mounts_watcher
    # 应用中心随后启动同一 Compose 项目；容器已按最新挂载重建时不会再次重建。
    exit 0
    ;;
  stop)
    # fnOS 应用中心负责停止声明的 Docker Compose 项目。
    exit 0
    ;;
  status)
    running=0
    is_running && running=1
    # 应用中心对 Docker 应用只调用 status，不调用 start；在这里确保 watcher 存活。
    stage_ensure_authorized_mounts_watcher
    [ "$running" -eq 1 ] && exit 0
    exit 3
    ;;
  *)
    write_error "不支持的生命周期命令：${1:-<empty>}。"
    exit 1
    ;;
esac

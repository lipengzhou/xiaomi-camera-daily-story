{
  "name": "xiaomi-camera-daily-story-sync",
  "version": "0.1.7",
  "private": true,
  "description": "面向飞牛 fnOS 的米家摄像头每日故事自动同步工具",
  "license": "MIT",
  "author": "xiaomi-camera-daily-story contributors",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "test:container": "tsx --test container-test/*.test.ts",
    "check": "npm run build && npm test && node --check public/app.js",
    "fpk:build": "fnpack build --directory fnos/xiaomi-camera-daily-story"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "fastify": "^5.12.8",
    "fetch-cookie": "^3.2.0",
    "tough-cookie": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

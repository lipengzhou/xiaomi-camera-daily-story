# 本地开发配置。npm run dev 会自动复制为 .env.local；该文件不会被自动覆盖。
# 修改 .env 或 .env.local 后，重新运行 npm run dev。
PORT=3210
XIAOMI_STORY_RUNTIME=local

# 相对路径基于项目根目录；默认目录已被 Git 和 Docker 构建排除。
# 扫码授权后，主密钥和加密凭证自动写入下面的目录，不需要在这里填写小米密码或 token。
XIAOMI_STORY_CONFIG_DIR=.dev/local/config
XIAOMI_STORY_DATA_DIR=.dev/local/data
XIAOMI_STORY_DOWNLOAD_ROOT=.dev/local/videos

# 默认从 PATH 查找，也可以填写可执行文件的完整路径。
# Windows 路径建议使用正斜杠，例如 C:/tools/ffmpeg/bin/ffmpeg.exe。
XIAOMI_STORY_FFMPEG=ffmpeg
XIAOMI_STORY_FFPROBE=ffprobe
